{
  "name": "halo-desk",
  "version": "1.0.0",
  "description": "Capsule flottante et assistant local pour le bureau",
  "author": "Halo Desk contributors",
  "main": "src/main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "io.halodesk.desktop",
    "productName": "Halo Desk",
    "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
    "files": [
      "src/**/*"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility",
      "syncDesktopName": true
    },
    "icon": "src/icon.png",
    "publish": null
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "desktopName": "io.halodesk.desktop.desktop"
}
